# =============================================
# 3ASYAPP TEMPLATE - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# See docs/DATABASE_SETUP.md for complete setup guide

# =============================================
# AUTHENTICATION MODE SELECTION
# =============================================
# Choose your authentication method:
# - 'supabase' for Supabase Auth (default, good for startups)
# - 'azure' for Azure AD (enterprise, SSO)
VITE_AUTH_MODE=supabase

# =============================================
# AZURE AD CONFIGURATION (for enterprise)
# =============================================
# Get these from your Azure App Registration
# Only required if VITE_AUTH_MODE=azure
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:8080/auth/callback

# Optional: Azure-specific settings
VITE_AZURE_CLOUD_INSTANCE=https://login.microsoftonline.com/
VITE_AZURE_GRAPH_ENDPOINT=https://graph.microsoft.com/

# =============================================
# SUPABASE CONFIGURATION (for standard auth)
# =============================================
# Get these from your Supabase project dashboard
# Only required if VITE_AUTH_MODE=supabase
# Leave empty for template development (will work in demo mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================
# SHARED CONFIGURATION
# =============================================
# These work with both authentication modes

# Blockchain Configuration (optional - for Web3 features)
VITE_CONTRACT_ADDRESS=
VITE_NETWORK_CHAIN_ID=1
VITE_INFURA_PROJECT_ID=
VITE_ALCHEMY_API_KEY=
VITE_ETHERSCAN_API_KEY=

# Stripe Payment Integration (optional - for subscriptions)
VITE_STRIPE_PUBLISHABLE_KEY=

# AI Integration (optional - for AI features)
VITE_OPENAI_API_KEY=
VITE_PINECONE_API_KEY=

# Analytics & Monitoring (optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# =============================================
# SETUP INSTRUCTIONS:
# =============================================
# 1. Copy this file: cp .env.example .env
# 2. Choose your auth mode (supabase or azure)
# 3. Fill in the required credentials for your chosen auth mode
# 4. Follow the appropriate setup guide:
#    - Supabase: docs/DATABASE_SETUP.md
#    - Azure AD: docs/AZURE_AD_INTEGRATION.md
# 5. Other services are optional - add as needed
# =============================================
